{
  "name": "@restorecommerce/notification-srv",
  "version": "1.2.8",
  "description": "Restorecommerce notification microservice",
  "main": "./dist/start.js",
  "author": "n-fuse GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/notification-srv.git"
  },
  "license": "MIT",
  "keywords": [
    "restore",
    "commerce",
    "microservice",
    "notification"
  ],
  "type": "module",
  "dependencies": {
    "@restorecommerce/chassis-srv": "^1.10.2",
    "@restorecommerce/grpc-client": "^2.3.3",
    "@restorecommerce/kafka-client": "^1.4.5",
    "@restorecommerce/logger": "^1.4.3",
    "@restorecommerce/mailer": "^1.1.3",
    "@restorecommerce/rc-grpc-clients": "^5.2.5",
    "@restorecommerce/scs-jobs": "^0.3.5",
    "@restorecommerce/service-config": "^1.2.3",
    "lodash-es": "^4.18.1",
    "redis": "^6.2.0",
    "retry": "^0.13.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@restorecommerce/dev": "^0.3.2",
    "@semantic-release-plus/docker": "^3.1.3",
    "@types/lodash-es": "^4.17.12",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3"
  },
  "scripts": {
    "start": "node ./dist/start.cjs",
    "dev": "cross-env NODE_ENV=development node dist/start.cjs",
    "pretest": "eslint src --fix",
    "test": "vitest run",
    "mocha": "cross-env NODE_ENV=test mocha -R spec --timeout 60000 --stack-trace --exit",
    "build:es": "node esbuild.mjs",
    "prebuild": "rimraf dist lib coverage",
    "build": "node esbuild.mjs",
    "postbuild": "cp ./node_modules/@platformatic/wasm-utils/dist/native.wasm ./dist/",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\""
  },
  "engines": {
    "node": ">= 26"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release-plus/docker",
        {
          "name": "docker.io/restorecommerce/notification-srv",
          "skipLogin": true
        }
      ],
      [
        "@semantic-release-plus/docker",
        {
          "name": "ghcr.io/restorecommerce/notification-srv",
          "skipLogin": true
        }
      ]
    ]
  }
}
